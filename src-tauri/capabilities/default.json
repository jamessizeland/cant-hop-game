{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:default",
    "fs:allow-write",
    {
      "identifier": "fs:scope-appcache-recursive",
      "allow": [
        {
          "path": "$APPCACHE/**/*"
        }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://github.com/jamessizeland/cant-hop-game/*"
        },
        {
          "url": "https://*.githubusercontent.com/*"
        }
      ]
    },
    "opener:default",
    "process:default",
    "store:default"
  ]
}
